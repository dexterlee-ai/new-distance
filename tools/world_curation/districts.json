        { "part": "year", "text": "十週年", "illus": true, "src": "11 b136", "beats": [4], "rest": true } ],
      "taps": [
        { "part": "screen", "beat": 1, "line": "眼動研究發現：廣告出現在畫面上，和被人看進去，是兩回事", "src": "10 b18" },
        { "part": "pile", "beat": 1, "line": "品牌可以買到曝光，卻買不到記憶", "src": "8 b70", "dot": false },
        { "part": "bubble", "beat": 2, "line": "同樣一則廣告，自己選擇看的人，品牌回想明顯高於被迫看的人", "src": "10 b85" },
        { "part": "light", "beat": 2, "line": "只要知道彼此正同時經歷同一件事，感受就可能被放大", "src": "11 b44" },
        { "part": "friend", "beat": 3, "line": "一起經歷過的記憶，更可能變成之後一再被談起的故事", "src": "11 b5", "dot": false },
        { "part": "stands", "beat": 4, "line": "想起和一群人共同經歷的過去，會讓人更想再靠近他們", "src": "11 b43" },
        { "part": "child", "beat": 4, "line": "好的懷舊不是讓上一代再看一次，而是讓下一代今天第一次走進來", "src": "11 b116" } ],
      "terms": [
        { "term": "自願性注意力（第 10 篇）", "gloss": "消費者自己選擇給的注意力；品牌回想明顯高於被迫觀看", "src": "10 b85" },
        { "term": "APM（第 10 篇）", "gloss": "每千次曝光的注意力秒數：看曝光有沒有真的被看進去", "src": "10 b20" },
        { "term": "受眾橋接（Audience Bridging，第 11 篇）", "gloss": "用大家都認得的記憶，把不同世代拉進同一場文化事件", "src": "11 b74, b81" } ],
      "note": "廣告畫面、曝光數字、十週年與人數皆為示意。",
      "related": ["oracle", "trust"],
      "line": "曝光買得到，記憶買不到：親身一起參與過的時刻，才會被記住、被分享、被傳下去。",
      "steps": [
        "廣告每打到一個人就算一次曝光，但被算到不等於被看進去。",
        "同一面螢幕改成邀請，自己決定舉燈的人，反而記住了品牌。",
        "沒人要求，大家自己拍照傳出去，把記憶帶出了場外。",
        "十年後記得的人又回來了，還帶上孩子，讓下一代第一次參與。"
      ],
      "quote": { "text": "版位可以買，但主動靠近、伸手拿、拍照分享、真的記住，買不到。", "n": 10, "page": 77, "id": "b86" },
