/*
!/.gitignore
!/README.md
!/.gitattributes
!/media/
!/world/
!/tools/

/tools/*
!/tools/build_world.py
!/tools/head_mesh.py
!/tools/subset_fonts.py
!/tools/serve_world.py
!/tools/deploy_pages.sh
!/tools/world_curation/

__pycache__/
*.pyc
.DS_Store
Thumbs.db
desktop.ini

# lab pages for the pilot, never committed or deployed
/world/_lab/
